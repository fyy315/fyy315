# ==============================================
# AI Trademark Platform - Environment Variables
# ==============================================
# 复制此文件为 .env.local 并填入实际值
# Copy to .env.local and fill in actual values

# ==============================================
# Supabase Configuration (Required)
# ==============================================
# 您可以在 Supabase Dashboard -> Settings -> API 中找到这些值
# Find these values in Supabase Dashboard -> Settings -> API

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (公开，安全)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (仅服务端使用，勿泄露)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret (在 Supabase Dashboard -> Settings -> API 中)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ==============================================
# Supabase Storage (Optional)
# ==============================================
# 用于文件上传功能
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project-id.supabase.co/storage/v1/object/public
NEXT_PUBLIC_STORAGE_BUCKET=uploads

# ==============================================
# Application Configuration
# ==============================================
# 网站 URL (用于邮件验证等)
NEXT_PUBLIC_SITE_URL=https://www.anyeb.com
NEXT_PUBLIC_APP_NAME=AI Trademark Platform

# ==============================================
# API Keys (Optional)
# ==============================================
# AI 服务 API Keys (如果使用)
# OPENAI_API_KEY=your-openai-key-here
# CLAUDE_API_KEY=your-claude-key-here

# ==============================================
# Node Environment (Do not modify)
# ==============================================
NODE_ENV=production